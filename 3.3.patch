+    def test_save_and_load_session_state(self, tmp_db):
+        store = SQLiteSessionPersistence(db_path=tmp_db)
+        store.open("test_client")
+
+        out_messages = {
+            1: MQTTMessage(mid=1, topic=b"test/topic1"),
+        }
+        msg = out_messages[1]
+        msg.qos = 1
